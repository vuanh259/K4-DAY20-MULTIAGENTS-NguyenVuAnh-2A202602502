# Lab 20 - GenzShop / modelapi.vn gateway
# Dien API key tao tren modelapi.vn vao dong ben duoi.
OPENAI_API_KEY=
OPENAI_API_BASE=https://modelapi.vn/v1

# GPT-6 Luna (ten API chinh xac)
LAB_MODEL=openai:gpt-6-luna
LAB_USE_RESPONSES_API=true
LAB_REASONING_EFFORT=low
LAB_MODEL_TIMEOUT=90
LAB_MODEL_MAX_RETRIES=1
# make_model() doc bien nay; harness bo temperature khi reasoning bat.
LAB_TEMPERATURE=1

# Endpoint va Responses API theo huong dan Codex cua GenzShop.
# Khong commit .env; khong dung ma doi thuong thay cho API key.
